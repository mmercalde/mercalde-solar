[Unit]
Description=Alarm if llama-server came up without the GPU
After=llama-server.service
Requires=llama-server.service

[Service]
Type=oneshot
User=michael
WorkingDirectory=/home/michael/mercalde-solar/agent
ExecStart=/home/michael/mercalde-solar/agent/venv/bin/python /home/michael/mercalde-solar/agent/llama_gpu_check.py
# Exit 1 means "fell back to the CPU", which is the point of the unit; it is
# not a reason to keep restarting it.
Restart=no

[Install]
WantedBy=multi-user.target
