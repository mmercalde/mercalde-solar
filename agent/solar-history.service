[Unit]
Description=Solar History API - read-only history for the dashboard's History section
After=network-online.target
Wants=network-online.target
# Independent of solar-agent on purpose: either can restart without the other.

[Service]
Type=simple
User=michael
Group=michael
WorkingDirectory=/home/michael/mercalde-solar/agent
ExecStart=/home/michael/mercalde-solar/agent/venv/bin/python /home/michael/mercalde-solar/agent/history_api.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Read-only: it opens history.sqlite with mode=ro and writes nothing. config.load()
# makes agent/data if it is missing, so that one path stays writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/michael/mercalde-solar/agent/data

[Install]
WantedBy=multi-user.target
