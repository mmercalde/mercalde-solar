[Unit]
Description=llama.cpp server (Qwen3-8B, Vulkan)
After=network.target dev-dri-renderD128.device
Wants=dev-dri-renderD128.device

[Service]
Type=simple
User=michael
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/dri/renderD128 ] && exit 0; sleep 1; done; exit 1'
# /dev/dri/renderD128 is root:render and card1 is root:video. Without these
# the only access is the logind session ACL, which does not exist yet at boot:
# llama.cpp then warns "no usable GPU found", ignores -ngl and serves from the
# CPU at ~35 tok/s while reporting active. See docs/kamrui_stability.md.
SupplementaryGroups=render video
WorkingDirectory=/home/michael/llama.cpp
ExecStart=/home/michael/llama.cpp/build/bin/llama-server -m /home/michael/models/Qwen3-8B-Q4_K_M.gguf -ngl 99 --host 0.0.0.0 --port 8080 -c 16384 --jinja --cache-reuse 256
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
