[Unit]
Description=llama.cpp server (Qwen3-8B, Vulkan)
After=network.target

[Service]
Type=simple
User=michael
WorkingDirectory=/home/michael/llama.cpp
ExecStart=/home/michael/llama.cpp/build/bin/llama-server -m /home/michael/models/Qwen3-8B-Q4_K_M.gguf -ngl 99 --host 0.0.0.0 --port 8080 -c 16384 --jinja
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
