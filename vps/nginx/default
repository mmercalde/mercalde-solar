map_hash_bucket_size 128;
# Access gate: one-time /unlock?key=... sets a 1-year cookie.
# $solar_locked is 1 (blocked) unless the cookie matches.
map $cookie_solarkey $solar_locked {
    default 1;
    "232ad57d2416e6f2c4af558acb933d8de70384bb9c7f9440" 0;
}

# Upstream with failover for solar dashboard
upstream solar_dashboard {
    server 10.8.0.2:8080 max_fails=2 fail_timeout=10s;    # Pi 5 - Primary
    server 192.168.6.72:8081 backup;                       # ESP8266 - Backup
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;
    server_name _;
    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;
    server_name mercalde-solar.org;

    # One-time unlock: visit /unlock?key=... once per device (bookmark it)
    location = /unlock {
        if ($arg_key != "232ad57d2416e6f2c4af558acb933d8de70384bb9c7f9440") { return 403; }
        add_header Set-Cookie "solarkey=232ad57d2416e6f2c4af558acb933d8de70384bb9c7f9440; Path=/; Max-Age=31536000; Secure; HttpOnly; SameSite=Lax";
        return 302 /dashboard;
    }

    # Alexa webhook
    location /alexa {
        proxy_pass http://127.0.0.1:5000/alexa;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Solar Dashboard with failover at /dashboard
    location /dashboard {
        proxy_pass http://solar_dashboard/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # Dashboard API endpoints
    location /data {
        proxy_pass http://solar_dashboard/data;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /setgen {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/setgen;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /stopgen {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/stopgen;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /config {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/config;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Solar agent. The dashboard proxies both of these to the KAMRUI itself;
    # nginx only has to decide who may reach them.
    #
    # /agent/plan is a read: the latest plan record, the learning gate and the
    # last few actions, which is what the dashboard badge shows. Open, like
    # /data, so the page renders for anyone who has the address.
    location /agent/plan {
        proxy_pass http://solar_dashboard/agent/plan;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 15s;
    }

    # /agent/ask is not a read. The agent answers with tools, and a question
    # can end with it proposing a threshold write for the guard to judge, so
    # it belongs with /setgen and /config behind the cookie rather than with
    # /data in front of it.
    location /agent/ask {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/agent/ask;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # The dashboard allows the agent 90s to think; this has to outlast it
        # or nginx times the request out first and the owner sees a failure
        # that did not happen.
        proxy_read_timeout 120s;
    }

    location /setmpptmode {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/setmpptmode;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Register tool endpoints
    location /registers {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/registers;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /readreg {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/readreg;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /writereg {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/writereg;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /readtransfer {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/readtransfer;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /readags {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/readags;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /testtelegram {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard/testtelegram;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # AC Diagnostic. One prefix block covers /acdiag, /acdiag/stream,
    # /acdiag/log and /acdiag/log/clear. proxy_pass carries no URI, so nginx
    # forwards the original path unchanged.
    location /acdiag {
        if ($solar_locked) { return 403; }
        proxy_pass http://solar_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        # /acdiag/stream blocks for ~10s while capturing; the 30s used
        # elsewhere is too tight if n or interval is raised.
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    # Locally vendored three.js, so the 3D view works with no uplink.
    location /vendor/ {
        proxy_pass http://solar_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        expires 7d;
    }

    # InsightLocal - main page
    location / {
        if ($solar_locked) { return 403; }
        proxy_pass https://10.8.0.2:443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
    }

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/mercalde-solar.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mercalde-solar.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = mercalde-solar.org) {
        return 301 https://$host$request_uri;
    }
    listen 80 ;
    listen [::]:80 ;
    server_name mercalde-solar.org;
    return 404;
}

# Direct access to ESP8266 on port 8080 (legacy)
server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    location / {
        if ($solar_locked) { return 403; }
        proxy_pass http://192.168.6.72:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
